# Use a dedicated MySQL-compatible local/test database; do not point tests at production.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/lexipay

# Optional merchant web links / notification links (must be an HTTPS origin in production)
LEXI_PUBLIC_URL=https://your-lexi-domain.example

# Required before merchant Telegram credentials may be encrypted and stored.
# Generate with: openssl rand -base64 32
LEXI_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Optional dedicated Solana RPC endpoints; defaults are public mainnet-beta/devnet RPC.
SOLANA_RPC_URL_MAINNET=
SOLANA_RPC_URL_DEVNET=
SOLANA_RECONCILE_INTERVAL_MS=15000

# Optional Resend email delivery
RESEND_API_KEY=
EMAIL_FROM=LEXI PayLink <payments@example.com>

# Optional server-wide Telegram fallback (merchant-specific credentials can be configured in Settings)
TELEGRAM_BOT_TOKEN=

# Optional PayBox SDK connection check; obtain the bearer token through PayBox's supported grant flow.
PAYBOX_ACCESS_TOKEN=

PORT=3000
NODE_ENV=development
